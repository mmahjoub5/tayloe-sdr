*
*****************************************************************************
* Support subcircuits
*****************************************************************************
*
.SUBCKT BLOCK_DC_H1_OPAx320-Q1 1 2 3 4
H_H1 3 4 VH_H1 1K
VH_H1 1 2 0
.ENDS BLOCK_DC_H1_OPAx320-Q1
*
.SUBCKT BLOCK_DC_H2_OPAx320-Q1 1 2 3 4
H_H2 3 4 VH_H2 1
VH_H2 1 2 0
.ENDS BLOCK_DC_H2_OPAx320-Q1
*
.SUBCKT BLOCK_DC_H3_OPAx320-Q1 1 2 3 4
H_H3 3 4 VH_H3 -1
VH_H3 1 2 0
.ENDS BLOCK_DC_H3_OPAx320-Q1
*
* VSWITCH(ROFF=1E12 RON=10M VOFF=0.0V VON=10MV) -> Vt=5m, Vh=-5m
.SUBCKT BLOCK_DC_S1_OPAx320-Q1 1 2 3 4
S_S1 3 4 1 2 SMOD_S1
RS_S1 1 2 1G noiseless
.MODEL SMOD_S1 SW(Ron=10m Roff=1E12 Vt=5m Vh=-5m)
.ENDS BLOCK_DC_S1_OPAx320-Q1
*
.SUBCKT BLOCK_DC_S2_OPAx320-Q1 1 2 3 4
S_S2 3 4 1 2 SMOD_S2
RS_S2 1 2 1G noiseless
.MODEL SMOD_S2 SW(Ron=10m Roff=1E12 Vt=5m Vh=-5m)
.ENDS BLOCK_DC_S2_OPAx320-Q1
*
.SUBCKT AOL_1_OPAx320-Q1 VCP VCN IOUTP IOUTN PARAMS: GAIN=1E-4 IPOS=.5 INEG=-.5
B1 IOUTP IOUTN I=limit(GAIN*V(VCP,VCN),INEG,IPOS)
.ENDS AOL_1_OPAx320-Q1
*
.SUBCKT AOL_2_OPAx320-Q1 VCP VCN IOUTP IOUTN PARAMS: GAIN=0.041697 IPOS=0.315 INEG=-0.315
B1 IOUTP IOUTN I=limit(GAIN*V(VCP,VCN),INEG,IPOS)
.ENDS AOL_2_OPAx320-Q1
*
.SUBCKT CLAMP_AMP_HI_OPAx320-Q1 VCP VCN VIN COM VOP VOM PARAMS: G=10
B_VOP COM VOP I=if(V(VIN,COM)>V(VCP,COM),(V(VIN,COM)-V(VCP,COM))*G,0)
B_VOM COM VOM I=if(V(VIN,COM)<V(VCN,COM),(V(VCN,COM)-V(VIN,COM))*G,0)
.ENDS CLAMP_AMP_HI_OPAx320-Q1
*
.SUBCKT CLAMP_AMP_LO_OPAx320-Q1 VCP VCN VIN COM VOP VOM PARAMS: G=1
B_VOP COM VOP I=if(V(VIN,COM)>V(VCP,COM),(V(VIN,COM)-V(VCP,COM))*G,0)
B_VOM COM VOM I=if(V(VIN,COM)<V(VCN,COM),(V(VCN,COM)-V(VIN,COM))*G,0)
.ENDS CLAMP_AMP_LO_OPAx320-Q1
*
.SUBCKT CLAWN_OPAx320-Q1 VCP VCN IOUTP IOUTN
B1 IOUTP IOUTN I=table(V(VCP,VCN),
+ 0, 10.96E-6,
+ 12.46, 0.00016055,
+ 23.46, 0.00033055,
+ 36.341, 0.0005865,
+ 46.919, 0.0008115,
+ 56.559, 0.0010602,
+ 64.905, 0.0014003,
+ 68.033, 0.0016047,
+ 69.597, 0.0018062,
+ 70.379, 0.0019381)
.ENDS CLAWN_OPAx320-Q1
*
.SUBCKT CLAWP_OPAx320-Q1 VCP VCN IOUTP IOUTN
B1 IOUTP IOUTN I=table(V(VCP,VCN),
+ 0, 10.73E-6,
+ 17.896, 0.0002413,
+ 35.793, 0.0006242,
+ 47.724, 0.0010174,
+ 49.514, 0.0010818,
+ 53.093, 0.0013016,
+ 56.690, 0.0015382,
+ 65, 0.00275)
.ENDS CLAWP_OPAx320-Q1
*
.SUBCKT CLAW_SRC_OPAx320-Q1 VCP VCN IOUTP IOUTN PARAMS: GAIN=1 IPOS=0.2E1 INEG=-0.23E1
B1 IOUTP IOUTN I=limit(GAIN*V(VCP,VCN),INEG,IPOS)
.ENDS CLAW_SRC_OPAx320-Q1
*
.SUBCKT CL_SRC_OPAx320-Q1 VCP VCN IOUTP IOUTN PARAMS: GAIN=1 IPOS=0.4E1 INEG=-0.46E1
B1 IOUTP IOUTN I=limit(GAIN*V(VCP,VCN),INEG,IPOS)
.ENDS CL_SRC_OPAx320-Q1
*
* VSWITCH(RON=50 ROFF=1E12 VON=500E-3 VOFF=100E-3) -> Vt=300m, Vh=-200m
.SUBCKT ESD_IN_OPAx320-Q1 ESDN ESDP VCC VEE
.MODEL ESD_SW SW(Ron=50 Roff=1E12 Vt=300m Vh=-200m)
S1 ESDN VCC ESDN VCC ESD_SW
S2 ESDP VCC ESDP VCC ESD_SW
S3 VEE ESDN VEE ESDN ESD_SW
S4 VEE ESDP VEE ESDP ESD_SW
.ENDS ESD_IN_OPAx320-Q1
*
.SUBCKT ESD_OUT_OPAx320-Q1 OUT VCC VEE
.MODEL ESD_SW SW(Ron=50 Roff=1E12 Vt=300m Vh=-200m)
S1 OUT VCC OUT VCC ESD_SW
S2 VEE OUT VEE OUT ESD_SW
.ENDS ESD_OUT_OPAx320-Q1
*
* Current-noise generator. R1/R2 are deliberately NOISY -- they are the source.
.SUBCKT FEMT_OPAx320-Q1 1 2 PARAMS: NVRF=0.6
E1 3 0 5 0 10
R1 5 0 {1.184*NVRF*NVRF}
R2 5 0 {1.184*NVRF*NVRF}
G1 1 2 3 0 1E-6
.ENDS FEMT_OPAx320-Q1
*
.SUBCKT GR_SRC_OPAx320-Q1 VCP VCN IOUTP IOUTN PARAMS: GAIN=1 IPOS=0.61E1 INEG=-0.61E1
B1 IOUTP IOUTN I=limit(GAIN*V(VCP,VCN),INEG,IPOS)
.ENDS GR_SRC_OPAx320-Q1
*
.SUBCKT IQ_SRC_OPAx320-Q1 VCP VCN IOUTP IOUTN PARAMS: GAIN=1E-3
B1 IOUTP IOUTN I=if(V(VCP,VCN)<=0,0,GAIN*V(VCP,VCN))
.ENDS IQ_SRC_OPAx320-Q1
*
.SUBCKT OL_SENSE_OPAx320-Q1 COM SWP OLN OLP
B_SW COM SWP I=if((V(OLN,COM)>10E-3)|(V(OLP,COM)>10E-3),1,0)
.ENDS OL_SENSE_OPAx320-Q1
*
* VSWITCH(RON=1E-3 ROFF=1E12 VON=900E-3 VOFF=800E-3) -> Vt=850m, Vh=-50m
.SUBCKT SW_OL_OPAx320-Q1 SWCTL MID CAP_L CAP_R
.MODEL OL_SW SW(Ron=1E-3 Roff=1E12 Vt=850m Vh=-50m)
S1 CAP_L CAP_R SWCTL MID OL_SW
.ENDS SW_OL_OPAx320-Q1
*
.SUBCKT VCM_CLAMP_OPAx320-Q1 VINP VINN IOUTN IOUTP VPP VPM PARAMS: GAIN=1
B1 IOUTP IOUTN I=limit(GAIN*V(VINP,VINN),V(VPM,VINN),V(VPP,VINN))
.ENDS VCM_CLAMP_OPAx320-Q1
*
* Voltage-noise generator: D1/D2 shot+flicker noise sets the 1/f corner,
* R4/R5 set the broadband floor. KF = sqrt(FLW)/1E11 evaluated at FLW=10.
.SUBCKT VNSE_OPAx320-Q1 1 2 PARAMS: FLW=10 GLF=0.08402 RNV=58.016
.MODEL DVN D(KF=3.16227766E-11 AF=1 IS=1.0E-16)
I1 0 7 10E-3
I2 0 8 10E-3
D1 7 0 DVN
D2 8 0 DVN
E1 3 6 7 8 {GLF}
R1 3 0 1E9 noiseless
R2 3 0 1E9 noiseless
R3 3 6 1E9 noiseless
E2 6 4 5 0 10
R4 5 0 {RNV}
R5 5 0 {RNV}
R6 3 4 1E9 noiseless
R7 4 0 1E9 noiseless
E3 1 2 3 4 1
.ENDS VNSE_OPAx320-Q1
*
.SUBCKT VOS_DRIFT_OPAx320-Q1 VOSP VOSN PARAMS: VOSDC=1.243E-05 POL=1 DRIFT=1.50E-06
B1 VOSP VOSN V=VOSDC+POL*DRIFT*(temp-27)
.ENDS VOS_DRIFT_OPAx320-Q1
*
.SUBCKT ZO_SRC_OPAx320-Q1 VCP VCN IOUTP IOUTN PARAMS: GAIN=10.4595 IPOS=6821.47E1 INEG=-7386.067E1
B1 IOUTP IOUTN I=limit(GAIN*V(VCP,VCN),INEG,IPOS)
.ENDS ZO_SRC_OPAx320-Q1
*
*****************************************************************************
* Convenience aliases: OPA320-Q1 (single) and OPA2320-Q1 (one channel of the
* dual -- instantiate it twice). Both are the same core as OPAx320-Q1.
*****************************************************************************
.SUBCKT OPA320-Q1 IN+ IN- VCC VEE OUT
X1 IN+ IN- VCC VEE OUT OPAx320-Q1
.ENDS OPA320-Q1
*
.SUBCKT OPA2320-Q1 IN+ IN- VCC VEE OUT
X1 IN+ IN- VCC VEE OUT OPAx320-Q1
.ENDS OPA2320-Q1
*
