- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Blocks:\n\nEach time this file is saved,\
      \ GRC will instantiate the first class it finds\nto get ports and parameters\
      \ of your block. The arguments to __init__  will\nbe the parameters. All of\
      \ them are required to have default values!\n\"\"\"\n\nimport time\n\nimport\
      \ numpy as np\nimport zmq\nfrom gnuradio import gr\n\n# Must match CONTROL in\
      \ iq_bridge.py. Kept as a constant rather than a GRC\n# parameter: an empty\
      \ field there generates `endpoint=` and fails to compile,\n# and a wrong one\
      \ fails silently, since ZMQ PUB discards messages nobody is\n# subscribed to.\n\
      CONTROL = 'tcp://127.0.0.1:5556'\n\n\nclass blk(gr.sync_block):\n    \"\"\"\
      Tune the radio board from GRC.\n\n    Samples pass through untouched; the block\
      \ exists for its `freq` parameter,\n    which is forwarded to iq_bridge.py over\
      \ ZMQ. Wire a QT GUI Range widget to\n    a variable and set freq to that variable\
      \ -- GRC calls the setter whenever\n    the slider moves.\n\n    Frequencies\
      \ are the station, not the LO: the bridge applies the Tayloe\n    divide-by-four\
      \ and the tuning offset itself, so 1170e3 means 1170 kHz.\n    \"\"\"\n\n  \
      \  def __init__(self, freq=1.17e6):\n        \"\"\"arguments to this function\
      \ show up as parameters in GRC\"\"\"\n        gr.sync_block.__init__(\n    \
      \        self,\n            name='Board Tuner',             # will show up in\
      \ GRC\n            in_sig=[np.complex64],\n            out_sig=[np.complex64]\n\
      \        )\n        self._ctx = zmq.Context()\n        self._sock = self._ctx.socket(zmq.PUB)\n\
      \        self._sock.connect(CONTROL)\n\n        # PUB silently discards anything\
      \ sent before the subscriber has\n        # connected, so a request sent immediately\
      \ would vanish anyway.\n        time.sleep(0.3)\n\n        # Adopt the starting\
      \ frequency WITHOUT transmitting it. The flowgraph\n        # is constructed\
      \ on every run, and sending here would abort the\n        # bridge's stream\
      \ and cost a second of audio at each start -- right\n        # when you are\
      \ listening for it to begin. The bridge already has a\n        # frequency;\
      \ nudge the slider if the two disagree.\n        self._freq = float(freq)\n\n\
      \    # A property, so GRC registers a callback on the matching parameter name.\n\
      \    @property\n    def freq(self):\n        return self._freq\n\n    @freq.setter\n\
      \    def freq(self, value):\n        value = float(value)\n        # Retuning\
      \ costs a second of audio -- the bridge has to abort the\n        # stream,\
      \ send the command and restart -- so ignore no-op updates.\n        if value\
      \ != self._freq:\n            self._freq = value\n            self._sock.send(str(value).encode())\n\
      \n    def work(self, input_items, output_items):\n        output_items[0][:]\
      \ = input_items[0]\n        return len(output_items[0])\n"
    affinity: ''
    alias: ''
    comment: ''
    freq: frequency
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: '(''Board Tuner'', ''blk'', [(''freq'', ''1170000.0'')], [(''0'', ''complex'',
      1)], [(''0'', ''complex'', 1)], ''Tune the radio board from GRC.\n\nSamples
      pass through untouched; the block exists for its `freq` parameter,\nwhich is
      forwarded to iq_bridge.py over ZMQ. Wire a QT GUI Range widget to\na variable
      and set freq to that variable -- GRC calls the setter whenever\nthe slider moves.\n\nFrequencies
      are the station, not the LO: the bridge applies the Tayloe\ndivide-by-four and
      the tuning offset itself, so 1170e3 means 1170 kHz.\n'', [''freq''])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [248, 292.0]
    rotation: 0
    state: enabled
